{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "forceConsistentCasingInFileNames": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "~/*": ["./src/*"],
      "~app/*": ["./src/app/*"],
      "~shared/*": ["./src/shared/*"],
      "~domains/*": ["./src/domains/*"],
      "~blog/*": ["./src/domains/blog/*"],
      "~home/*": ["./src/domains/home/*"],
      "~project/*": ["./src/domains/project/*"],
      "~resume/*": ["./src/domains/resume/*"],
      "~search/*": ["./src/domains/search/*"],
      "~site/*": ["./src/domains/site/*"]
    },
    "incremental": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
